{
  "name": "healthpal",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "expo start",
    "init:dev": "cp env/dev.env .env",
    "init:staging": "cp env/staging.env .env",
    "prebuild": "npx expo prebuild --clean --no-install",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest  --verbose --watchAll --no-coverage",
    "coverage": "jest --coverage",
    "android:new": "pnpm prebuild && pnpm android",
    "ios:new": "pnpm prebuild && pnpm ios",
    "lint": "expo lint --no-cache",
    "script:fetch-types": "node ./scripts/fetch-types.js",
    "script:generate-phone-masks": "node ./scripts/generate-phone-masks.js",
    "postinstall": "patch-package && husky",
    "knip": "knip"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^6.18.2",
    "@formatjs/intl-locale": "^4.2.12",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/material-top-tabs": "^7.3.8",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-navigation/stack": "^7.4.8",
    "@reduxjs/toolkit": "^2.9.0",
    "@shopify/flash-list": "^2.3.2",
    "@turf/turf": "^7.2.0",
    "dayjs": "^1.11.18",
    "eslint-plugin-react-native": "^5.0.0",
    "expo": "58.0.21",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.5.10",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.65.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.1.8",
    "react-native": "0.88.1",
    "react-native-advanced-input-mask": "^1.4.6",
    "react-native-bootsplash": "^7.3.4",
    "react-native-calendars": "^1.1314.0",
    "react-native-confirmation-code-field": "^9.0.0",
    "react-native-date-picker": "5.0.13",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "9.0.7",
    "react-native-permissions": "^5.6.3",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.1",
    "react-native-yamap-plus": "6.12.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/compat": "^1.4.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.9.1",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "expo-dev-client": "~58.0.17",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.13",
    "knip": "^5.66.2",
    "libphonenumber-js": "^1.13.15",
    "node-fetch": "^3.3.2",
    "openapi-typescript": "^7.9.1",
    "patch-package": "^8.0.1",
    "plop": "^4.0.4",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "19.3.0",
    "ts-morph": "^27.0.0",
    "typescript": "^6.0.3"
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup"
    ],
    "silent": false,
    "collectCoverage": true,
    "setupFilesAfterEnv": [
      "<rootDir>/__tests__/config/setup-tests.ts"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__tests__/config/mocks/svgMock.js"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/config/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/)?(immer|expo|expo-.*|@expo|expo-modules-core|react-redux|react-native-gesture-handler|react-native-confirmation-code-field|@react-native|react-native|@react-navigation|react-native-worklets|@react-native-community|react-native-reanimated)[/@+])"
    ],
    "collectCoverageFrom": [
      "<rootDir>/src/**/*.{ts,tsx,js,jsx}",
      "!<rootDir>/src/assets/**/*"
    ]
  }
}
